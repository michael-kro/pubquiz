{
  "name": "pubquiz",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted live pub quiz. Teams join from their phones by QR code.",
  "type": "module",
  "bin": {
    "pubquiz": "server/main.ts"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "node --watch server/main.ts examples/sample-quiz.yaml",
    "test": "PUBQUIZ_POINTS_UNIT=1000 node --test --test-timeout=60000 --test-force-exit \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test",
    "build:binaries": "node scripts/build-binaries.mjs",
    "docker:build": "docker build -t pubquiz ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
